# ── Documentation (managed outside repo) ──
docs/
# NOTE: tests/ is tracked. Do NOT ignore it, or newly-added test files are
# silently dropped from git (they never show in `git status`). __pycache__/
# under tests/ is still covered by the Python-artifacts rule below.

# ── Python artifacts ──
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
*.manifest
*.spec

# ── Virtual environments ──
.venv/
venv/
ENV/
env/
.python-version

# ── Testing artifacts ──
.pytest_cache/
pytest_cache/
pytest.ini
.coverage
htmlcov/
.tox/
.nox/

# ── IDE / Editors ──
.idea/
.vscode/
*.swp
*.swo
*~

# ── OS files ──
.DS_Store
Thumbs.db

# ── Environment & secrets ──
.env
.env.local
*.pem
*.key
secrets/

# ── Runtime data (mounted as volumes) ──
config/
data/
temp/

# ── GitHub (track workflows and instructions only) ──
.github/*
!.github/workflows/

# ── Git worktrees ──
.worktrees/

# ── Logs ──
*.log
logs/

# ── Docker overrides ──
docker-compose.override.yml

# ── Local host-test scaffolding (not committed) ──
docker-compose.windows.yml
tools/check_position.py

# ── Misc loose root files ──
start.sh
.git.bak/

claude-portable/
